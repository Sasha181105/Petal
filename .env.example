# Copy to .env.local and fill in from your Supabase project.
# Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only — used to add staff (Settings → Team) and by the seed/add-user scripts.
# Needed on Vercel too. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: this site's public address, used in password-reset and invitation emails.
# Leave empty locally; set it on Vercel, e.g. https://petal.vercel.app
NEXT_PUBLIC_SITE_URL=

# Supabase → Connect → "Transaction pooler" (port 6543). Used by the app, incl. on Vercel.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase → Connect → "Session pooler" (port 5432). Used by drizzle-kit for migrations.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Cloudinary (flower photos) → cloudinary.com → Settings → API Keys.
# Optional: without these, the app works and shows placeholders instead of photos.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
# Server only, never NEXT_PUBLIC_.
CLOUDINARY_API_SECRET=your-api-secret

# Demo login created by `npm run db:seed`
DEMO_USER_EMAIL=demo@petal.app
DEMO_USER_PASSWORD=change-me-please

# Public demo: "Open the demo shop" button and sample figures on the home page.
# Leave false for a real shop; set true only for a public showcase deployment.
PUBLIC_DEMO=false
