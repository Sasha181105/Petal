# Copy to .env.local and fill in from your Supabase project.
# Never commit .env.local.
#
# On Vercel, set everything in the "App" block. The "Local only" block is for
# migrations and dev scripts run from your computer.

# ── App ─────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only: adds staff (Settings → Team) and finishes manager sign-ups.
# Never expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase → Connect → "Transaction pooler" (port 6543).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# This site's public address, used in links inside emails (sign-up, invites, resets).
# Leave empty locally; on Vercel set it, e.g. https://petal.example.com
NEXT_PUBLIC_SITE_URL=

# Cloudinary (flower photos) → cloudinary.com → Settings → API Keys.
# Optional: without these, uploads are hidden and flowers show placeholders.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
# Server only, never NEXT_PUBLIC_.
CLOUDINARY_API_SECRET=your-api-secret

# ── Local only ──────────────────────────────────────────────────────────────

# Supabase → Connect → "Session pooler" (port 5432). Used by `npm run db:migrate`.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Sample shop for local development (`npm run db:seed`). Not used by the site.
DEMO_USER_EMAIL=demo@petal.app
DEMO_USER_PASSWORD=change-me-please
